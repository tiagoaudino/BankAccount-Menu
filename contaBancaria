class ContaBancaria {

    private String nome;
    private String tipoConta;
    private double saldo;

    public ContaBancaria(String nome, String tipoConta, double saldo) {
        this.nome = nome;
        this.tipoConta = tipoConta;
        this.saldo = saldo;
    }

    public void consultarSaldo() {
        System.out.printf("Saldo atual: R$"+saldo);
        System.out.println(" ");
    }

    public void receberValor(double valor) {

        if (valor <= 0) {
            System.out.println("Valor inválido.");
            System.out.println(" ");
            return;
        }

        saldo += valor;

        System.out.printf("Recebido: R$"+ valor);
        System.out.println(" ");
        System.out.printf("Saldo atual: R$"+saldo);
        System.out.println(" ");
    }

    public void transferirValor(double valor) {

        if (valor <= 0) {
            System.out.println("Valor inválido.");
            System.out.println(" ");
            return;
        }

        if (valor > saldo) {
            System.out.println("Saldo insuficiente.");
            System.out.println(" ");
            return;
        }

        saldo -= valor;

        System.out.printf("Transferido: R$"+valor);
        System.out.println(" ");
        System.out.printf("Saldo atual: R$"+saldo);
        System.out.println(" ");
    }

    public void exibirDados() {
        System.out.println("=== Dados da Conta ===");
        System.out.println("Nome: "+nome);
        System.out.println("Tipo da conta: "+tipoConta);
        System.out.printf("Saldo: R$"+ saldo);
        System.out.println(" ");
    }

    public void encerrar() {
        System.out.println("Sistema encerrado.");
    }
}
